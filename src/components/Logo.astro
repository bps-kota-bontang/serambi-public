---
import Image from '~/components/common/Image.astro';
import { SITE } from 'astrowind:config';
import { twMerge } from 'tailwind-merge';
---

<span
  class="self-center ml-2 rtl:ml-0 rtl:mr-2 text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white flex items-end"
>
  <Image
    src="~/assets/images/serambi-logo.png"
    alt="Logo"
    class={twMerge('w-10 h-10 mr-2')}
    layout="cover"
    loading="lazy"
    decoding="async"
  />
  {SITE?.name}
</span>
