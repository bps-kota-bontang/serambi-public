---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Serambi - Layanan Publik untuk Anda.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Mulai Jelajah',
        href: '#layanan-publik',
        icon: 'tabler:binoculars-filled',
      },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'Serambi Hero Image' }}
  >
    <Fragment slot="title">
      Selamat Datang di <span class="text-accent dark:text-white highlight">Serambi</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline"> Temukan berbagai layanan publik yang kami sediakan untuk Anda di sini.</span>
      <span class="block mb-1 sm:hidden font-bold">Serambi: Layanan Publik untuk Anda.</span>
    </Fragment>
  </Hero>

  <!-- Features2 Widget ************** -->

  <Features2
    id="layanan-publik"
    title="Daftar Layanan Publik"
    subtitle="Tempat untuk menemukan layanan publik yang tersedia"
    tagline="Layanan Publik"
    items={[
      {
        title: 'Temu by BPS Kota Bontang',
        description: 'Layanan konsultasi statistik melalui saluran obrolan dan video',
        image: {
          src: '~/assets/images/temu-logo.png',
          alt: 'Temu Logo',
          supportsDarkMode: true,
        },
        link: 'https://temu.databontang.com',
      },
      {
        title: 'Perpustakaan PST',
        description: 'Layanan perpusatakaan digital Badan Pusat Statistik',
        image: {
          src: '~/assets/images/pst-logo.png',
          alt: 'Perpustakaan PST Logo',
        },
        link: 'https://perpustakaan.bps.go.id',
      },
      {
        title: 'Romantik Online',
        description: 'Layanan rekomendasi kegiatan statistik',
        image: {
          src: '~/assets/images/romantik-logo.png',
          alt: 'Romantik Logo',
        },
        link: 'https://romantik.web.bps.go.id',
      },
      {
        title: 'PPID',
        description: 'Portal PPID Badan Pusat Statistik Kota Bontang',
        image: {
          src: '~/assets/images/ppid-logo.png',
          alt: 'PPID Logo',
        },
        link: 'https://ppid.bps.go.id/?mfd=6474',
      },
      {
        title: 'Bontang Idola',
        description: 'Bandingkan indikator strategis se Provinsi Kalimantan Timur',
        image: {
          src: '~/assets/images/bontang-idola-logo.png',
          alt: 'Bontang Idola Logo',
        },
        link: 'https://play.google.com/store/apps/details?id=id.bps.bontang.idola',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>
</Layout>
